{
  "name": "frombuilder",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "description": "Signframe Form-Definition Builder (visual)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:etapa0": "esbuild tests/etapa0.fichaRaw.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.fichaRaw.cjs --log-level=error && node .tmp/etapa0.fichaRaw.cjs",
    "test:mapping": "esbuild tests/matrixMapping.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/matrixMapping.cjs --log-level=error && node .tmp/matrixMapping.cjs",
    "test": "npm run test:mapping && npm run test:etapa0 && npm run test:pdf && npm run test:acroname && npm run test:align && npm run test:write && npm run test:regiones",
    "test:pdf": "esbuild tests/etapa0.pdfFields.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.pdfFields.cjs --log-level=error && node .tmp/etapa0.pdfFields.cjs",
    "test:acroname": "esbuild tests/etapa0.acroName.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.acroName.cjs --log-level=error && node .tmp/etapa0.acroName.cjs",
    "test:align": "esbuild tests/etapa0.align.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.align.cjs --log-level=error && node .tmp/etapa0.align.cjs",
    "test:write": "esbuild tests/etapa0.write.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.write.cjs --log-level=error && node .tmp/etapa0.write.cjs",
    "test:regiones": "esbuild tests/etapa0.regiones.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.regiones.cjs --log-level=error --external:pdfjs-dist && node .tmp/etapa0.regiones.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.7",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
