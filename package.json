{
  "name": "frombuilder",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Signframe Form-Definition Builder (visual)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:etapa0": "esbuild tests/etapa0.fichaRaw.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.fichaRaw.cjs --log-level=error && node .tmp/etapa0.fichaRaw.cjs",
    "test": "npm run test:etapa0 && npm run test:pdf && npm run test:write && npm run test:manuales && npm run test:rects && npm run test:paquete && npm run test:importar && npm run test:impreso",
    "test:pdf": "esbuild tests/etapa0.pdfFields.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.pdfFields.cjs --log-level=error && node .tmp/etapa0.pdfFields.cjs",
    "test:write": "esbuild tests/etapa0.write.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.write.cjs --log-level=error && node .tmp/etapa0.write.cjs",
    "test:manuales": "esbuild tests/etapa0.camposManuales.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.camposManuales.cjs --log-level=error && node .tmp/etapa0.camposManuales.cjs",
    "test:paquete": "esbuild tests/etapa0.paquete.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.paquete.cjs --log-level=error --external:pdfjs-dist --external:xlsx && node .tmp/etapa0.paquete.cjs",
    "test:impreso": "esbuild tests/etapa0.impreso.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.impreso.cjs --log-level=error --external:pdfjs-dist && node .tmp/etapa0.impreso.cjs",
    "test:rects": "esbuild tests/etapa0.rects.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.rects.cjs --log-level=error && node .tmp/etapa0.rects.cjs",
    "test:importar": "esbuild tests/etapa0.importar.test.ts --bundle --platform=node --format=cjs --outfile=.tmp/etapa0.importar.cjs --log-level=error --external:xlsx && node .tmp/etapa0.importar.cjs",
    "fixture:ficha": "esbuild tools/gen-ficha-sintetica.ts --bundle --platform=node --format=cjs --outfile=.tmp/genficha.cjs --log-level=error && node .tmp/genficha.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.454.0",
    "nanoid": "^5.0.7",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
